{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "harness.tool.v1.response.schema.json",
  "title": "harness.tool.v1 response",
  "type": "object",
  "additionalProperties": false,
  "unevaluatedProperties": false,
  "required": ["contract", "ok", "truncated", "duration_ms", "blobs"],
  "properties": {
    "contract": { "const": "harness.tool.v1" },
    "ok": { "type": "boolean" },
    "truncated": { "type": "boolean" },
    "duration_ms": { "type": "integer", "minimum": 0, "maximum": 600000 },
    "blobs": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 36,
        "maxLength": 36,
        "description": "uuid в нижнем регистре"
      }
    },
    "text": {
      "type": "string",
      "maxLength": 65536,
      "description": "До 65536 кодпоинтов. В модель после разбора входит не больше 8000: это подготовка текста, не отказ ответа."
    },
    "error": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^\\u0000-\\u001F\\u007F\\u0080-\\u009F]{1,400}$",
      "description": "Без U+0000–U+001F, U+007F и U+0080–U+009F. Квантификатор 400 — два UTF-16 на кодпоинт, длину режет maxLength."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "ok": { "const": true } },
        "required": ["ok"]
      },
      "then": {
        "required": ["text"],
        "not": { "required": ["error"] }
      },
      "else": {
        "required": ["error"],
        "not": { "required": ["text"] },
        "properties": {
          "blobs": { "maxItems": 0 }
        }
      }
    }
  ]
}
