{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "harness.services.v1.schema.json",
  "title": "harness.services.v1",
  "type": "object",
  "additionalProperties": false,
  "unevaluatedProperties": false,
  "required": ["contract", "services"],
  "properties": {
    "contract": {
      "const": "harness.services.v1"
    },
    "services": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/service"
      }
    }
  },
  "$defs": {
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "base_url", "tools"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "description": "Начинается со строчной латинской буквы. Дальше строчные, цифры, _ и -."
        },
        "base_url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "anyOf": [
            {
              "pattern": "^(?:https?://(?:127\\.0\\.0\\.1|127\\.0\\.0\\.1:(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])))/?$"
            },
            {
              "pattern": "^https://(?:10\\.(?:0|[1-9][0-9]?|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.(?:0|[1-9][0-9]?|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.(?:0|[1-9][0-9]?|1[0-9]{2}|2[0-4][0-9]|25[0-5])|10\\.(?:0|[1-9][0-9]?|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.(?:0|[1-9][0-9]?|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.(?:0|[1-9][0-9]?|1[0-9]{2}|2[0-4][0-9]|25[0-5]):(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))/?$"
            },
            {
              "pattern": "^https://(?:172\\.(?:1[6-9]|2[0-9]|3[0-1])\\.(?:0|[1-9][0-9]?|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.(?:0|[1-9][0-9]?|1[0-9]{2}|2[0-4][0-9]|25[0-5])|172\\.(?:1[6-9]|2[0-9]|3[0-1])\\.(?:0|[1-9][0-9]?|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.(?:0|[1-9][0-9]?|1[0-9]{2}|2[0-4][0-9]|25[0-5]):(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))/?$"
            },
            {
              "pattern": "^https://(?:192\\.168\\.(?:0|[1-9][0-9]?|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.(?:0|[1-9][0-9]?|1[0-9]{2}|2[0-4][0-9]|25[0-5])|192\\.168\\.(?:0|[1-9][0-9]?|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.(?:0|[1-9][0-9]?|1[0-9]{2}|2[0-4][0-9]|25[0-5]):(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))/?$"
            }
          ],
          "description": "Литерал IPv4 без userinfo, query и fragment. Путь пустой или /. http только для 127.0.0.1. Иной частный адрес — https и tls_fingerprint256. 0.0.0.0, имя DNS и IPv6 не подходят."
        },
        "tls_fingerprint256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "description": "64 шестнадцатеричных символа в нижнем регистре. Пин сертификата, не секрет."
        },
        "tools": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/tool"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "base_url": {
                "pattern": "^(?:https?://(?:127\\.0\\.0\\.1|127\\.0\\.0\\.1:(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])))/?$"
              }
            },
            "required": ["base_url"]
          },
          "else": {
            "required": ["tls_fingerprint256"]
          }
        }
      ]
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "effect", "description", "accepts_blobs", "parameters"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "effect": {
          "enum": ["read", "write"]
        },
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "accepts_blobs": {
          "type": "boolean"
        },
        "parameters": {
          "allOf": [
            {
              "$ref": "#/$defs/parameters"
            },
            {
              "required": ["type"],
              "properties": {
                "type": {
                  "const": "object"
                }
              }
            }
          ]
        }
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "unevaluatedProperties": false,
      "required": ["type"],
      "description": "Файл оператора принимает только type, properties, required, additionalProperties, maxLength, minLength, enum, maxItems. pattern, $ref, $data, allOf и items файл бракуют. У объекта additionalProperties равен false. Имя из required есть в properties. Значение enum совпадает с type. minLength не больше maxLength. Вложенность properties не глубже 8. Хаб этот документ не компилирует.",
      "properties": {
        "type": {
          "enum": ["object", "string", "integer", "number", "boolean"]
        },
        "additionalProperties": {
          "const": false
        },
        "properties": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "additionalProperties": {
            "$ref": "#/$defs/parameters"
          }
        },
        "required": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "minLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        },
        "maxLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        },
        "enum": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32
        },
        "maxItems": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "object"
              }
            },
            "required": ["type"]
          },
          "then": {
            "required": ["additionalProperties"]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": ["properties"]
                },
                {
                  "required": ["required"]
                },
                {
                  "required": ["additionalProperties"]
                }
              ]
            }
          }
        },
        {
          "if": {
            "anyOf": [
              {
                "required": ["minLength"]
              },
              {
                "required": ["maxLength"]
              }
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "string"
              }
            },
            "required": ["type"]
          }
        },
        {
          "if": {
            "properties": {
              "required": {
                "type": "array",
                "minItems": 1
              }
            },
            "required": ["required"]
          },
          "then": {
            "required": ["properties"]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "string"
              }
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "enum": {
                "items": {
                  "type": "string",
                  "maxLength": 64
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "boolean"
              }
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "enum": {
                "items": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "integer"
              }
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "enum": {
                "items": {
                  "type": "integer"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "number"
              }
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "enum": {
                "items": {
                  "type": "number"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "object"
              }
            },
            "required": ["type"]
          },
          "then": {
            "not": {
              "required": ["enum"]
            }
          }
        }
      ]
    }
  }
}
