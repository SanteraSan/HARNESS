{
  "name": "harness",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "migrate": "node --env-file=.env --import tsx src/db/migrate.ts",
    "seed": "node --env-file=.env --import tsx src/db/seed.ts",
    "test": "node --env-file=.env ./node_modules/vitest/vitest.mjs run",
    "test:coverage": "node --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs run --coverage",
    "api": "node --env-file=.env --import tsx src/api/index.ts",
    "worker": "node --env-file=.env --import tsx src/worker.ts",
    "telegram": "node --env-file=.env --import tsx src/telegram/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "grammy": "1.46.0",
    "hono": "4.13.16",
    "pino": "10.4.0",
    "postgres": "3.4.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "9.39.5",
    "eslint-plugin-security": "4.2.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
